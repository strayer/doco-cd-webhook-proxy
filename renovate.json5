{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  // updates wait three days so that malware scanners and researchers get a look
  // first (Renovate's own security presets use the same value); vulnerability
  // alert PRs skip the wait and are raised immediately
  "minimumReleaseAge": "3 days",
  // nothing merges on its own except GitHub Actions bumps (see packageRules):
  // merged dependency PRs are the cue to cut a release, so they stay visible
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "packageRules": [
    {
      // Actions never ship in the artifact, so they may land without a release
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true
    },
    {
      // Go toolchain and the dev tools built against it move together: a newer Go
      // needs a golangci-lint built with it, and Go version sync needs all pins equal
      "groupName": "Go toolchain",
      "matchDepNames": ["go", "golang"],
      // no cooldown for the toolchain itself: Go point releases are mostly security
      // fixes straight from go.dev, and the golang image's Docker Hub timestamp
      // resets on every rebuild, which would split this group into a failing PR
      "minimumReleaseAge": null
    },
    {
      // rebuilds of the golang image under an unchanged tag still wait
      "matchDatasources": ["docker"],
      "matchDepNames": ["golang"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": "3 days"
    },
    { "groupName": "Go toolchain", "matchManagers": ["mise"] },
    {
      // without this the gomod manager never bumps the go directive
      "matchManagers": ["gomod"], "matchDepNames": ["go"], "rangeStrategy": "bump"
    },
    { "matchUpdateTypes": ["major"], "automerge": false }
  ]
}
